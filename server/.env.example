# ========================
# BTMeals Server — .env
# ========================

# Node environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL="postgresql://btmeals:yourpassword@localhost:5432/btmeals"

# JWT Secrets (use strong random strings in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Firebase (for push notifications) — get from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# Seed defaults (used by db:seed script)
SEED_HOSTEL_NAME="B.T. Men's Hall"
SEED_HOSTEL_CODE=BTMH
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=admin123
